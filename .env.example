# সাইটের পূর্ণ ঠিকানা (sitemap.xml, robots.txt ও Open Graph ট্যাগে ব্যবহার হয়)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres ডেটাবেস (না দিলে content/ ফোল্ডারের JSON থেকে সাইট চলে, লাইভে এডিট করা যায় না)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# অ্যাডমিন প্যানেলের (/admin) পাসওয়ার্ড
ADMIN_PASSWORD=change-me
